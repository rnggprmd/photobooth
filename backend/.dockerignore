# ─────────────────────────────────────────────
#  .dockerignore – Backend (Laravel)
# ─────────────────────────────────────────────

# Git
.git
.gitignore
.gitattributes

# Dependencies (akan di-install saat build)
vendor/
node_modules/

# Build artifacts
public/build/
public/hot

# Storage (akan di-mount via volume)
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Environment files
.env
.env.*
!.env.example
!.env.docker

# Docker files — hanya Dockerfile yang tidak perlu di-copy ke container
# JANGAN exclude docker-entrypoint.sh! Dipakai oleh ENTRYPOINT di Dockerfile.
Dockerfile

# Tests
tests/

# Editor files
.idea/
.vscode/
*.suo
*.sw?

# OS files
.DS_Store
Thumbs.db

# Database
database/*.sqlite
database/*.sqlite-journal
